# ==============================================================================
# R.S. ENTERPRISES CMS (Strapi 5) - Environment Template
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=1337
# Public URL when deployed behind Hostinger reverse proxy (e.g., https://cms.rsesolution.com)
PUBLIC_URL=http://localhost:1337

# Security & Secrets (Generate strong random keys using `openssl rand -base64 32`)
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database Configuration
# Local Development: client defaults to sqlite (uses DATABASE_FILENAME)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production (Hostinger Business MySQL Configuration)
# When NODE_ENV=production, config/env/production/database.ts enforces MySQL:
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=u123456789_strapi
# DATABASE_USERNAME=u123456789_admin
# DATABASE_PASSWORD=your_secure_mysql_password
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Media Uploads
# Local uploads are stored in public/uploads.
# On Hostinger, symlink public/uploads to persistent storage outside release folder.
