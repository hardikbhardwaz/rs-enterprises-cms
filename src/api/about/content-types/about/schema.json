{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About",
    "description": "Corporate history, vision, manufacturing capabilities, and founder leadership"
  },
  "options": {
